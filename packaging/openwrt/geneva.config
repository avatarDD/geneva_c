# /etc/config/geneva
# The strategy is read from strategy_file (one line; "/etc/init.d/geneva
# reload" re-reads it without dropping connections).

config run 'main'
	option enabled '0'
	option strategy_file '/etc/geneva/strategy.txt'
	# ports of the service on the remote side: 80,443 or 8000-8100
	option ports '80,443'
	# tcp, udp or tcp,udp
	option proto 'tcp'
	# WAN interface (empty: all)
	option iface ''
	option queue '310'
	# auto, nft or iptables
	option firewall 'auto'
	option control 'unix:/var/run/geneva.sock'
	option control_token ''
	option log_level 'info'
	# JSON Lines events for zapret-gui and others: a file, or empty
	option events ''
	# more options of "geneva run", as is
	option extra ''

# The agent of a server-side evaluation (docs/SERVER_SIDE.md). It makes
# probes for an evaluator that the token holder runs elsewhere.
config agent 'agent'
	option enabled '0'
	# listen for the evaluator, or dial it with "connect"
	option listen 'tcp:0.0.0.0:7110'
	option connect ''
	option token ''
	option log_level 'info'
